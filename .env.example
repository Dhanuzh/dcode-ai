# Antigravity (Google) OAuth desktop-app credentials
# Desktop-app client secrets are public by design (embedded in every copy of the app)
# Used by BOTH the "Antigravity" and "Antigravity OAuth" providers — both are
# Cloud Code Assist logins on the same bundled client, stored under separate
# credential slots so they don't overwrite each other.
DCODE_ANTIGRAVITY_CLIENT_ID=your-client-id-here
DCODE_ANTIGRAVITY_CLIENT_SECRET=your-client-secret-here
